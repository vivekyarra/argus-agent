# ── Gemini API ────────────────────────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google Cloud Storage ──────────────────────────────────────
# Bucket name for screenshot and action log persistence
GCS_BUCKET_NAME=argus-agent-storage

# ── Google Cloud Firestore ────────────────────────────────────
# GCP project ID for Firestore (auto-detected on Cloud Run)
GCP_PROJECT_ID=your_gcp_project_id_here

# ── Backend Configuration ─────────────────────────────────────
BACKEND_URL=ws://localhost:8000/ws
CONTEXT_WINDOW_MINUTES=1

# ── Client Configuration ─────────────────────────────────────
SCREENSHOT_INTERVAL=10
PIXEL_DIFF_THRESHOLD=15
WAKE_WORD=argus

# ── Security ──────────────────────────────────────────────────
# API key for WebSocket authentication (generate a strong random string)
# In production, store this in Google Cloud Secret Manager instead
ARGUS_API_KEY=your_secure_api_key_here

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate limiting: requests per minute per client
RATE_LIMIT_PER_MINUTE=60

# ── Google Cloud Secret Manager ──────────────────────────────
# When deployed on GCP, Secret Manager pulls credentials at runtime.
# GCP_PROJECT_ID (above) is also used by Secret Manager.
# Secrets are fetched by name: GEMINI_API_KEY, ARGUS_API_KEY, etc.
# In local dev, env vars above serve as fallback.

# ── Google Cloud Logging ─────────────────────────────────────
# Cloud Logging is auto-configured when running on GCP.
# No additional configuration needed. Install google-cloud-logging
# to enable: pip install google-cloud-logging

